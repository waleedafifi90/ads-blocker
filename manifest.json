{
  "manifest_version": 3,
  "name": "Watch Shield",
  "description": "Blocks pop-unders, invisible click traps and forced redirects on streaming sites.",
  "homepage_url": "https://www.linkedin.com/in/walafifi/",
  "version": "0.1.4",
  "minimum_chrome_version": "119",
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Watch Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad-hosts",
        "enabled": true,
        "path": "rules/ad-hosts.json"
      }
    ]
  }
}
